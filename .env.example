# eLearning Application Environment Variables
# Copy this file to .env.development or .env.production

# ===========================================
# API Configuration
# ===========================================

# PocketBase API URL
# Development: http://127.0.0.1:5002
# Production: https://elearning-api.nihilanth.co.uk
REACT_APP_API_URL=http://127.0.0.1:5002

# ===========================================
# Application Configuration
# ===========================================

# Application domain (for CORS, etc.)
# Development: localhost:3000
# Production: elearning-demo.nihilanth.co.uk
APP_DOMAIN=localhost:3000

# API domain (for CORS, etc.)
# Development: localhost:5002
# Production: elearning-api.nihilanth.co.uk
API_DOMAIN=localhost:5002

# ===========================================
# Testing Configuration
# ===========================================

# Base URL for E2E tests
E2E_BASE_URL=http://localhost:3000

# ===========================================
# Build Configuration
# ===========================================

# Disable source maps in production builds (optional)
# GENERATE_SOURCEMAP=false

# Node environment
# NODE_ENV=development
